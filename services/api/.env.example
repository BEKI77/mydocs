PORT=4000
DATABASE_URL=postgres://wallet:wallet@localhost:5433/digital_wallet
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
# Uploaded documents (private, never served statically)
STORAGE_DIR=./storage
# Issuer private signing keys (MVP: files on the server; production: KMS/HSM)
ISSUER_KEYS_DIR=./.keys
CORS_ORIGINS=http://localhost:5174,http://localhost:1420,tauri://localhost,http://tauri.localhost
# Base URL encoded into presentation QR codes
VERIFY_BASE_URL=http://localhost:5174/v
PRESENTATION_TTL_SECONDS=120
# Set to 1 when running behind one reverse proxy
TRUST_PROXY=0
# Seeded mock issuer account
SEED_ISSUER_EMAIL=officer@gov.example
SEED_ISSUER_PASSWORD=change-me-too
